{
  "name": "dsh-conda-workspace-env",
  "version": "0.2.6",
  "description": "Choose and persist a Conda environment per DeepSeek Harness workspace",
  "type": "module",
  "main": "./src/plugin.js",
  "exports": { ".": "./src/plugin.js", "./client": "./src/client/index.js", "./package.json": "./package.json" },
  "files": ["src/", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-conversation"] }
  },
  "engines": { "node": ">=22" },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0",
    "react": "^18.2.0"
  },
  "keywords": ["dsh-plugin", "conda", "workspace", "environment"],
  "license": "MIT"
}
